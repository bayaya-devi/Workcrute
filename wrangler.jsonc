{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workcrute",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf", "**/*.png"], "fallthrough": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "vars": { "APP_ORIGIN": "https://workcrute.pages.dev", "ENVIRONMENT": "production", "EMAIL_FROM": "e.berdouzi@call-manage.com", "CHATBOT_MODEL": "@cf/meta/llama-3.2-1b-instruct" },
  "secrets": { "required": ["SESSION_PEPPER", "ADMIN_AUTH_SECRET_1", "ADMIN_AUTH_SECRET_2"] },
  "d1_databases": [{ "binding": "DB", "database_name": "workcrute", "database_id": "f5947d57-a281-4cc6-b878-724f647881e1", "migrations_dir": "migrations" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
  ,"triggers": { "crons": ["*/1 * * * *"] }
}
